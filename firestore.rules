rules_version = '2';

/* Arena — Firestore rules for the shared order store.
 *
 * Publish from the Firebase console (Firestore → Rules) or run
 * `firebase deploy --only firestore:rules`.
 *
 * These are demo-grade by design, matching the rest of the storefront:
 * a customer only needs their order number to follow their own order, and
 * the admin dashboard lists orders without a Firebase sign-in. Before
 * taking real money, require Firebase Auth for `list` and `update` (only
 * the admin session should advance an order's status) and scope `get` to
 * signed-in owners. See the README section "Firebase backend".
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      function validOrder(data) {
        return data.id is string
          && data.id == orderId
          && data.id.matches('^AET-[0-9]{4}-[A-Z0-9-]{6,40}$')
          && data.email is string
          && data.email.size() <= 120
          && data.name is string
          && data.name.size() <= 60
          && data.status in ['paid', 'packed', 'shipped', 'delivered', 'cancelled', 'refunded']
          && data.placedAt is number
          && data.total is number
          && data.total >= 0
          && data.total <= 100000000
          && data.items is list
          && data.items.size() > 0
          && data.items.size() <= 50
          && data.history is list
          && data.history.size() <= 20;
      }

      /* customer tracking: fetch one order by its number (AET-YYYY-XXXXXX-XXXXXX) */
      allow get: if true;
      /* admin dashboard reads the queue without a Firebase sign-in */
      allow list: if true;
      /* orders are always written whole (setDoc with merge), never patched */
      allow create: if validOrder(request.resource.data);
      allow update: if validOrder(request.resource.data);
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      /* the exact proof the serverless gate expects: the order must exist,
         carry the product in itemsById, and match the total to the cent.
         rules can't read list elements, so the order embeds itemsById. */
      function provesPurchase(review, order) {
        return order != null
          && order.total == review.orderTotal
          && order.itemsById != null
          && order.itemsById[review.productId] != null
          && order.itemsById[review.productId].qty is number
          && order.itemsById[review.productId].qty > 0;
      }

      allow read: if true;
      allow create: if request.resource.data.id == reviewId
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 40
        && request.resource.data.productId.matches('^[a-z0-9-]{2,40}$')
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.orderId is string
        && request.resource.data.orderId.matches('^AET-[0-9]{4}-[A-Z0-9-]{6,40}$')
        && request.resource.data.orderTotal is number
        && provesPurchase(request.resource.data, get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data);
      /* idempotent re-push only: same review (order+product) with a valid
         proof may be re-set after a lost response — never re-aimed at
         another product or order */
      allow update: if resource.data.orderId == request.resource.data.orderId
        && resource.data.productId == request.resource.data.productId
        && request.resource.data.orderTotal is number
        && provesPurchase(request.resource.data, get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data);
      allow delete: if false;
    }

    /* everything else (accounts, settings, subscribers) stays local */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
